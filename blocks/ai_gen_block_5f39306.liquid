{% doc %}
  @prompt
    "about us" section block with a example motives behind building this handicraft selling website promoting Indian handicraft and artisans in this generation of ai, make the block a little shorter
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-us-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-about-us-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-about-us-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 30px;
  }

  .ai-about-us-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-about-us-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-about-us-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media screen and (min-width: 750px) {
    .ai-about-us-content-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    }
  }

  .ai-about-us-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-about-us-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: 50%;
    color: {{ block.settings.icon_color }};
  }

  .ai-about-us-card-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
  }

  .ai-about-us-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-about-us-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-about-us-card-text-{{ ai_gen_id }} p {
    margin: 0 0 10px;
  }

  .ai-about-us-card-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-about-us-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-about-us-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-about-us-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<about-us-{{ ai_gen_id }} class="ai-about-us-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-about-us-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-about-us-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-about-us-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-about-us-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-about-us-content-{{ ai_gen_id }}">
      <div class="ai-about-us-card-{{ ai_gen_id }}">
        <div class="ai-about-us-card-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <h3 class="ai-about-us-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
        <div class="ai-about-us-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</div>
      </div>

      <div class="ai-about-us-card-{{ ai_gen_id }}">
        <div class="ai-about-us-card-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3 class="ai-about-us-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
        <div class="ai-about-us-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</div>
      </div>

      <div class="ai-about-us-card-{{ ai_gen_id }}">
        <div class="ai-about-us-card-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
            <line x1="9" y1="9" x2="9.01" y2="9"></line>
            <line x1="15" y1="9" x2="15.01" y2="9"></line>
          </svg>
        </div>
        <h3 class="ai-about-us-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
        <div class="ai-about-us-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</div>
      </div>
    </div>
  </div>
</about-us-{{ ai_gen_id }}>

<script>
  (function() {
    class AboutUs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('about-us-{{ ai_gen_id }}', AboutUs{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "About us",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our Mission"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Preserving heritage, empowering artisans"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "inline_richtext",
      "id": "card_1_title",
      "label": "Title",
      "default": "Celebrating Indian craftsmanship"
    },
    {
      "type": "richtext",
      "id": "card_1_text",
      "label": "Text",
      "default": "<p>In an age of mass production and AI-driven automation, we believe in the irreplaceable value of human touch. Each handcrafted piece tells a story of tradition, skill, and cultural heritage passed down through generations.</p>"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "inline_richtext",
      "id": "card_2_title",
      "label": "Title",
      "default": "Empowering artisans"
    },
    {
      "type": "richtext",
      "id": "card_2_text",
      "label": "Text",
      "default": "<p>We partner directly with skilled artisans across India, ensuring fair compensation and sustainable livelihoods. By connecting their craft with conscious consumers, we help preserve traditional art forms while supporting local communities.</p>"
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "inline_richtext",
      "id": "card_3_title",
      "label": "Title",
      "default": "Bridging tradition and modernity"
    },
    {
      "type": "richtext",
      "id": "card_3_text",
      "label": "Text",
      "default": "<p>While technology shapes our world, we use it to amplify—not replace—human creativity. Our platform brings centuries-old craftsmanship to your doorstep, proving that authentic, handmade beauty has a timeless place in modern life.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card title size",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Card text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Card padding",
      "default": 25
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Card border thickness",
      "default": 1
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Icon size",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f8f1ed"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#252525"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#252525"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background",
      "default": "#4D1513"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "About us"
    }
  ]
