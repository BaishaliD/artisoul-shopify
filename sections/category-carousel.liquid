{%- comment -%}
  Dynamic Category Carousel
  - Automatically pulls in any collection tagged with the value set in section settings
  - No manual block-adding needed: tag a collection, it shows up here
{%- endcomment -%}

<section class="category-carousel-section" id="category-carousel-{{ section.id }}">
  <div class="category-carousel-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="category-carousel-wrapper">
    <button class="category-carousel-arrow prev" aria-label="Previous">&#8249;</button>

    <div class="category-carousel-track" id="category-track-{{ section.id }}">
      {%- assign carousel_tag = section.settings.carousel_tag -%}
      {%- for collection in collections -%}
        {% comment %} {%- if collection.tags contains carousel_tag -%} {% endcomment %}
          <a href="{{ collection.url }}" class="category-carousel-item">
            <div class="category-carousel-image">
              {%- if collection.image -%}
                <img
                  src="{{ collection.image | image_url: width: 400 }}"
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {%- else -%}
                <div class="category-carousel-placeholder"></div>
              {%- endif -%}
            </div>
            <p class="category-carousel-title">{{ collection.title }}</p>
          </a>
        {% comment %} {%- endif -%} {% endcomment %}
      {%- endfor -%}
    </div>

    <button class="category-carousel-arrow next" aria-label="Next">&#8250;</button>
  </div>
</section>

<style>
  .category-carousel-section {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
  }

  .category-carousel-header h2 {
    font-size: 24px;
    margin-bottom: 20px;
  }

  .category-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .category-carousel-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }

  .category-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .category-carousel-item {
    flex: 0 0 auto;
    width: 160px;
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
    text-align: center;
  }

  .category-carousel-image {
    width: 160px;
    height: 160px;
    border-radius: 4px;
    overflow: hidden;
    background: #f2f2f2;
  }

  .category-carousel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-carousel-placeholder {
    width: 100%;
    height: 100%;
    background: #e0e0e0;
  }

  .category-carousel-title {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
  }

  .category-carousel-arrow {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    font-size: 20px;
    cursor: pointer;
    flex-shrink: 0;
    z-index: 2;
  }

  .category-carousel-arrow.prev {
    margin-right: 10px;
  }

  .category-carousel-arrow.next {
    margin-left: 10px;
  }

  @media (max-width: 749px) {
    .category-carousel-arrow {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var track = document.getElementById('category-track-{{ section.id }}');
    var wrapper = document.getElementById('category-carousel-{{ section.id }}');
    if (!track || !wrapper) return;

    var prevBtn = wrapper.querySelector('.category-carousel-arrow.prev');
    var nextBtn = wrapper.querySelector('.category-carousel-arrow.next');
    var scrollAmount = 200;

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Category Carousel",
  "settings": [
    {
      "type": "text",
      "id": "carousel_tag",
      "label": "Collection tag to include",
      "default": "show-in-carousel",
      "info": "Only collections with this tag will appear in the carousel. Add this tag to a collection to include it, remove to exclude."
    }
  ],
  "presets": [
    {
      "name": "Category Carousel"
    }
  ]
}
{% endschema %}


{% comment %} {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }, {% endcomment %}