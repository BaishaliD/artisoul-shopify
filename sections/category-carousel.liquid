{%- comment -%}
  Dynamic Category Carousel
  - Automatically pulls in any collection tagged with the value set in section settings
  - No manual block-adding needed: tag a collection, it shows up here
  - Circular thumbnails with the label beneath; the row centres itself and only
    becomes scrollable (with arrows) when the collections overflow the viewport
{%- endcomment -%}

<section class="category-carousel-section" id="category-carousel-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="category-carousel-header">
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="category-carousel-wrapper">
    <button class="category-carousel-arrow prev" type="button" aria-label="Scroll categories left">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <div class="category-carousel-track" id="category-track-{{ section.id }}">
      {%- assign carousel_tag = section.settings.carousel_tag -%}
      {%- for collection in collections -%}
        {% comment %} {%- if collection.tags contains carousel_tag -%} {% endcomment %}
          <a href="{{ collection.url }}" class="category-carousel-item">
            <div class="category-carousel-image">
              {%- if collection.image -%}
                <img
                  src="{{ collection.image | image_url: width: 300 }}"
                  srcset="
                    {{ collection.image | image_url: width: 150 }} 150w,
                    {{ collection.image | image_url: width: 300 }} 300w,
                    {{ collection.image | image_url: width: 450 }} 450w
                  "
                  sizes="{{ section.settings.circle_size }}px"
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {%- else -%}
                <div class="category-carousel-placeholder"></div>
              {%- endif -%}
            </div>
            <p class="category-carousel-title">{{ collection.title }}</p>
          </a>
        {% comment %} {%- endif -%} {% endcomment %}
      {%- endfor -%}
    </div>

    <button class="category-carousel-arrow next" type="button" aria-label="Scroll categories right">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</section>

<style>
  #category-carousel-{{ section.id }} {
    --cc-size: {{ section.settings.circle_size }}px;
    --cc-gap: {{ section.settings.gap }}px;
    --cc-arrow: 40px;
  }

  .category-carousel-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .category-carousel-header h2 {
    font-size: 2.4rem;
    text-align: center;
    margin: 0 0 2.4rem;
  }

  .category-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  .category-carousel-track {
    display: flex;
    gap: var(--cc-gap);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1 1 auto;
    /* Centre while it fits; `safe` keeps the first item reachable once it overflows */
    justify-content: center;
    justify-content: safe center;
    padding-bottom: 4px;
  }

  .category-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .category-carousel-item {
    flex: 0 0 auto;
    width: var(--cc-size);
    text-decoration: none;
    color: inherit;
    scroll-snap-align: center;
    text-align: center;
  }

  .category-carousel-image {
    width: var(--cc-size);
    height: var(--cc-size);
    border-radius: 50%;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }

  .category-carousel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Zoom the photo inside the clip; the circle itself never changes size */
    transition: transform 0.4s ease;
  }

  .category-carousel-item:hover .category-carousel-image img {
    transform: scale(1.08);
  }

  .category-carousel-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.06);
  }

  .category-carousel-title {
    margin: 1.6rem 0 0;
    font-size: 1.6rem;
    line-height: 1.3;
    font-weight: 400;
  }

  /* Arrows stay hidden unless JS finds the track actually overflows */
  .category-carousel-arrow {
    display: none;
    /* Flex centring keeps the chevron optically centred; text glyphs never are */
    align-items: center;
    justify-content: center;
    padding: 0;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    color: rgb(var(--color-foreground));
    border-radius: 50%;
    width: var(--cc-arrow);
    height: var(--cc-arrow);
    cursor: pointer;
    flex-shrink: 0;
    /* Centre on the circle only — `center` would include the label below it */
    align-self: flex-start;
    margin-top: calc((var(--cc-size) - var(--cc-arrow)) / 2);
    z-index: 2;
    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .category-carousel-arrow svg {
    display: block;
  }

  .category-carousel-arrow:hover {
    background: rgba(var(--color-foreground), 0.06);
    border-color: rgba(var(--color-foreground), 0.35);
  }

  .category-carousel-arrow:focus-visible {
    outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
    outline-offset: 0.2rem;
  }

  .category-carousel-wrapper.is-overflowing .category-carousel-arrow {
    display: flex;
  }

  /*
   * Reveal on hover. Gated behind `hover: hover` so touch devices — where
   * :hover either never fires or sticks after a tap — keep the arrows visible.
   */
  @media (hover: hover) {
    .category-carousel-arrow {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* focus-within keeps them reachable by keyboard, where there is no pointer */
    .category-carousel-section:hover .category-carousel-arrow,
    .category-carousel-section:focus-within .category-carousel-arrow {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  /*
   * Nothing left to scroll that way: keep the footprint so the row cannot shift.
   * Declared after the hover rules and at equal specificity, so it wins the tie.
   */
  .category-carousel-section .category-carousel-arrow.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .category-carousel-arrow.prev {
    margin-right: 10px;
  }

  .category-carousel-arrow.next {
    margin-left: 10px;
  }

  @media screen and (max-width: 749px) {
    #category-carousel-{{ section.id }} {
      --cc-size: {{ section.settings.circle_size | times: 0.65 | round }}px;
      --cc-gap: {{ section.settings.gap | times: 0.6 | round }}px;
    }

    .category-carousel-section {
      padding-left: 16px;
      padding-right: 16px;
    }

    .category-carousel-title {
      font-size: 1.4rem;
      margin-top: 1.2rem;
    }

    .category-carousel-wrapper.is-overflowing .category-carousel-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-carousel-image img,
    .category-carousel-item:hover .category-carousel-image img {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var track = document.getElementById('category-track-{{ section.id }}');
    var section = document.getElementById('category-carousel-{{ section.id }}');
    if (!track || !section) return;

    var wrapper = section.querySelector('.category-carousel-wrapper');
    var prevBtn = section.querySelector('.category-carousel-arrow.prev');
    var nextBtn = section.querySelector('.category-carousel-arrow.next');

    function step() {
      var item = track.querySelector('.category-carousel-item');
      if (!item) return 200;
      var styles = window.getComputedStyle(track);
      return item.offsetWidth + (parseInt(styles.columnGap || styles.gap, 10) || 0);
    }

    // Show arrows only when the row overflows, and only in a direction
    // that still has something to scroll to.
    function syncOverflow() {
      var overflowing = track.scrollWidth > track.clientWidth + 1;
      wrapper.classList.toggle('is-overflowing', overflowing);

      var maxScroll = track.scrollWidth - track.clientWidth;
      var atStart = track.scrollLeft <= 1;
      var atEnd = track.scrollLeft >= maxScroll - 1;

      if (prevBtn) prevBtn.classList.toggle('is-hidden', !overflowing || atStart);
      if (nextBtn) nextBtn.classList.toggle('is-hidden', !overflowing || atEnd);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
    }

    syncOverflow();
    track.addEventListener('scroll', syncOverflow, { passive: true });
    window.addEventListener('resize', syncOverflow);
    if (window.ResizeObserver) {
      new ResizeObserver(syncOverflow).observe(track);
    }
  })();
</script>

{% schema %}
{
  "name": "Category Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide the heading."
    },
    {
      "type": "text",
      "id": "carousel_tag",
      "label": "Collection tag to include",
      "default": "show-in-carousel",
      "info": "Only collections with this tag will appear in the carousel. Add this tag to a collection to include it, remove to exclude."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "circle_size",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Circle size",
      "default": 120
    },
    {
      "type": "range",
      "id": "gap",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Category Carousel"
    }
  ]
}
{% endschema %}
