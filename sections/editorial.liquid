{%- comment -%}
  Editorial
  - Four-slot collage: one featured card, two small cards, one wide card.
    Slot 1 is always the featured one; `desktop_layout` only moves it left/right.
  - Capped at 4 blocks on purpose. For more cards, stack a second Editorial
    section with the headings left blank and top padding at 0.
  - Fewer than 4 blocks degrades to a full layout rather than leaving holes.
  - Title falls back to the collection's title; kicker and description never
    fall back — leave them blank and they simply do not render.
  - A card with no image (neither an override nor a collection image) renders
    as a solid card in the theme-wide card colour scheme.
{%- endcomment -%}

{{ 'section-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign card_count = section.blocks.size
  assign has_header = false
  if section.settings.eyebrow != blank or section.settings.heading != blank
    assign has_header = true
  endif
-%}

{%- style -%}
  #editorial-{{ section.id }} {
    --editorial-gap: {{ section.settings.gap }}px;

    {%- comment -%}
      The whole overlay ramp scales off one setting, so lowering it thins the
      gradient evenly instead of just clipping its darkest stop. At 0 every
      stop is transparent and the overlay is effectively off.
    {%- endcomment -%}
    --editorial-overlay-1: {{ section.settings.image_overlay | divided_by: 100.0 }};
    --editorial-overlay-2: {{ section.settings.image_overlay | times: 0.55 | divided_by: 100.0 }};
    --editorial-overlay-3: {{ section.settings.image_overlay | times: 0.18 | divided_by: 100.0 }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div
    id="editorial-{{ section.id }}"
    class="editorial editorial--{{ section.settings.heading_alignment }} page-width section-{{ section.id }}-padding"
    {{ section.shopify_attributes }}
  >
    {%- if has_header -%}
      <div class="editorial__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="editorial__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="editorial__grid editorial__grid--{{ section.settings.desktop_layout }} editorial__grid--count-{{ card_count }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign position = forloop.index
          assign col = block.settings.collection
          assign title = block.settings.title | default: col.title

          # `col.image` only — `featured_image` silently borrows the first
          # product's photo, which would defeat the solid-card fallback
          assign image = block.settings.image | default: col.image

          if position == 1
            assign sizes = '(min-width: 990px) 630px, (min-width: 750px) 52vw, calc(100vw - 30px)'
          elsif position == 4
            assign sizes = '(min-width: 990px) 570px, (min-width: 750px) 45vw, calc(100vw - 30px)'
          else
            assign sizes = '(min-width: 990px) 280px, (min-width: 750px) 22vw, calc((100vw - 30px) / 2)'
          endif

          # A card with no collection has nowhere to go, so it renders as a div
          assign card_tag = 'div'
          if col != blank
            assign card_tag = 'a'
          endif
        -%}

        <{{ card_tag }}
          {% if col != blank %}href="{{ col.url }}"{% endif %}
          class="editorial__card editorial__card--pos-{{ position }} {% if image != blank %}editorial__card--image{% else %}editorial__card--solid color-{{ settings.card_color_scheme }} gradient{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if image != blank -%}
            <div class="editorial__media">
              {{
                image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '200, 300, 400, 550, 750, 900, 1100, 1300, 1600',
                  alt: title
              }}
            </div>
            <div class="editorial__scrim"></div>
          {%- endif -%}

          <div class="editorial__content">
            {%- if block.settings.kicker != blank -%}
              <p class="editorial__kicker">{{ block.settings.kicker | escape }}</p>
            {%- endif -%}

            {%- if title != blank -%}
              <h3 class="editorial__title">{{ title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="editorial__text">{{ block.settings.description | escape | newline_to_br }}</p>
            {%- endif -%}

            {%- if block.settings.link_label != blank -%}
              <span class="editorial__link">
                {{- block.settings.link_label | escape }}
                <svg viewBox="0 0 20 12" width="18" height="11" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <line x1="0" y1="6" x2="18" y2="6" />
                  <polyline points="13 1 18 6 13 11" />
                </svg>
              </span>
            {%- endif -%}
          </div>
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "info": "Small uppercase line above the heading. Leave blank to hide.",
      "default": "Shop the material"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide.",
      "default": "Brass, clay, wood, thread"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "info": "Which side the first (featured) card sits on. Mobile always keeps the featured card on top.",
      "options": [
        { "value": "left", "label": "Featured card left" },
        { "value": "right", "label": "Featured card right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "info": "Soft dark shading that fades upward from the bottom of each image card, so the text stays legible. Set to 0 to turn it off.",
      "default": 70
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between cards",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The card links here and uses this collection's image and title."
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Overline",
          "info": "Optional. Small uppercase line above the title, e.g. Craft story."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional. Falls back to the collection's own title."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Optional. Shown only if filled in — it never falls back to the collection description."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Optional. Adds an arrow link, e.g. Shop bestsellers. The whole card is clickable either way."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Falls back to the collection's image. With no image at all, the card renders as a solid colour block."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
