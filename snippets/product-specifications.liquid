{%- comment -%}
  Product Specifications accordion block.
  Reads from product metafields. Custom values win; the shopify.* standard and
  category (taxonomy) metafields are fallbacks. A row is hidden when every
  source for it is blank.
    Dimension  custom.dimensions
    Weight     custom.weight
    Finish     custom.finish   -> shopify.finish
    Material   custom.material -> shopify.material -> shopify.tableware-material
    Color      custom.color    -> shopify.color-pattern

  Value formatting (single vs. list, metaobject vs. scalar) is handled by the
  metafield-value snippet.
{%- endcomment -%}

{%- liquid
  capture dim
    render 'metafield-value', mf: product.metafields.custom.dimensions
  endcapture
  assign dim = dim | strip

  capture wt
    render 'metafield-value', mf: product.metafields.custom.weight
  endcapture
  assign wt = wt | strip

  capture finish
    render 'metafield-value', mf: product.metafields.custom.finish, mf2: product.metafields.shopify.finish
  endcapture
  assign finish = finish | strip

  capture material
    render 'metafield-value', mf: product.metafields.custom.material, mf2: product.metafields.shopify.material, mf3: product.metafields.shopify['tableware-material']
  endcapture
  assign material = material | strip

  capture color
    render 'metafield-value', mf: product.metafields.custom.color, mf2: product.metafields.shopify['color-pattern']
  endcapture
  assign color = color | strip

  assign has_specs = false
  if dim != blank or wt != blank or finish != blank or material != blank or color != blank
    assign has_specs = true
  endif
-%}

{%- if has_specs -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section.id }}">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">
            {{- block.settings.heading | default: 'Specifications' | escape -}}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
        <dl class="spec-list">
          {%- if dim != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Dimension</dt>
              <dd class="spec-list__value">{{ dim }}</dd>
            </div>
          {%- endif -%}
          {%- if wt != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Weight</dt>
              <dd class="spec-list__value">{{ wt }}</dd>
            </div>
          {%- endif -%}
          {%- if finish != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Finish</dt>
              <dd class="spec-list__value">{{ finish }}</dd>
            </div>
          {%- endif -%}
          {%- if material != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Material</dt>
              <dd class="spec-list__value">{{ material }}</dd>
            </div>
          {%- endif -%}
          {%- if color != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Color</dt>
              <dd class="spec-list__value">{{ color }}</dd>
            </div>
          {%- endif -%}
        </dl>
      </div>
    </details>
  </div>
{%- endif -%}
