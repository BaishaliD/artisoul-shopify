{%- comment -%}
  Product Specifications accordion block.
  Reads from product metafields:
    custom.dimensions, custom.weight, custom.finish
    shopify.finish, shopify.material, shopify.color-pattern
{%- endcomment -%}

{%- liquid
  assign dim = product.metafields.custom.dimensions.value
  if product.metafields.custom.dimensions.type contains 'list.'
    assign dim = dim | join: ', '
  endif

  assign wt = product.metafields.custom.weight.value
  if product.metafields.custom.weight.type contains 'list.'
    assign wt = wt | join: ', '
  endif

  assign finish = product.metafields.custom.finish.value
  if product.metafields.custom.finish.type contains 'list.'
    assign finish = finish | join: ', '
  endif
  if finish == blank
    assign finish = product.metafields.shopify.finish.value | map: 'name' | join: ', '
  endif

  assign material = product.metafields.shopify.material.value | map: 'name' | join: ', '
  assign color = product.metafields.shopify.color-pattern.value | map: 'name' | join: ', '

  assign has_specs = false
  if dim != blank or wt != blank or finish != blank or material != blank or color != blank
    assign has_specs = true
  endif
-%}

{%- if has_specs -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section.id }}">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">
            {{- block.settings.heading | default: 'Specifications' | escape -}}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
        <dl class="spec-list">
          {%- if dim != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Dimension</dt>
              <dd class="spec-list__value">{{ dim }}</dd>
            </div>
          {%- endif -%}
          {%- if wt != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Weight</dt>
              <dd class="spec-list__value">{{ wt }}</dd>
            </div>
          {%- endif -%}
          {%- if finish != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Finish</dt>
              <dd class="spec-list__value">{{ finish }}</dd>
            </div>
          {%- endif -%}
          {%- if material != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Material</dt>
              <dd class="spec-list__value">{{ material }}</dd>
            </div>
          {%- endif -%}
          {%- if color != blank -%}
            <div class="spec-list__row">
              <dt class="spec-list__label">Color</dt>
              <dd class="spec-list__value">{{ color }}</dd>
            </div>
          {%- endif -%}
        </dl>
      </div>
    </details>
  </div>
{%- endif -%}
